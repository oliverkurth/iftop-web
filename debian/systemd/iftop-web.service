[Unit]
Description=iftop web interface
Documentation=file:///usr/share/doc/iftop-web/README.Debian
After=network.target iftop-collector.service
Wants=iftop-collector.service

[Service]
Type=simple
User=_iftop-web
Group=_iftop-web
Environment=IFTOP_WEB_CONFIG=/etc/iftop-web/config.toml PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/usr/share/iftop-web
ExecStart=/usr/bin/gunicorn -c /usr/share/iftop-web/gunicorn.conf.py
Restart=on-failure
RestartSec=5

# Allows binding to port 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=iftop-web
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
